# Đổi tên file này thành .env (cùng thư mục main.py) rồi điền giá trị.
# KHÔNG đưa file .env lên GitHub.

# ---- Bắt buộc ----
WEB_PASSWORD=
BOT_TOKEN=
# chat_id Telegram được dùng bot, cách nhau dấu phẩy (nhắn bot một tin để biết chat id của bạn)
ALLOWED_USERS=
# nơi nhận cảnh báo dịch vụ ngoài hỏng; trống = người đầu tiên trong ALLOWED_USERS
ADMIN_CHAT_ID=

# ---- Key AI (nhập sau trong web panel cũng được) ----
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---- Chỉ đặt ở đây (web không sửa được) ----
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# POT_SERVER=http://ip:4416

# ---- Tuỳ chọn ----
# Chỉ cần nếu Botkeep không tự cấp SERVER_PORT: điền đúng cổng trên link web
# PORT=40430
# FFMPEG_THREADS=0          # 0 = theo số lõi container
# CACHE_MAX_MB=500          # trần ổ đĩa cho cache theo bước
# HEALTH_CHECK_HOURS=6      # kiểm tra dịch vụ ngoài định kỳ; 0 = tắt
# ALLOWED_DOMAINS=          # thêm tên miền được gửi link, cách nhau dấu phẩy
# OUT_MAX_MB=400            # tổng video kết quả giữ cho web tải về
