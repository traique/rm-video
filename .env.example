# Mẫu file .env cho Video Bot. Chép thành file tên ".env" đặt CÙNG THƯ MỤC với main.py rồi điền giá trị.
# Mỗi dòng một biến: TÊN=giá trị. Giá trị có dấu # hoặc dấu cách thì bọc trong "...".
# Dòng bắt đầu bằng # là ghi chú, bot bỏ qua. Muốn đổi một biến ở mục 4, 5: xoá dấu # ở đầu dòng rồi sửa giá trị.
# Thứ tự ưu tiên: Cài đặt lưu trên web > biến trong panel Botkeep (Startup) > file .env > mặc định trong mã.
# KHÔNG đưa file .env lên GitHub, không gửi cho ai. Sửa .env xong phải khởi động lại bot.

# ===== 1. BẮT BUỘC =====
# Mật khẩu vào web, nên từ 12 ký tự trở lên. Thiếu thì web khoá hoàn toàn.
WEB_PASSWORD=
# Token bot Telegram lấy từ @BotFather. Để trống = chỉ dùng web.
BOT_TOKEN=
# chat_id Telegram được dùng bot, cách nhau dấu phẩy. Chưa biết thì nhắn bot một tin, bot báo chat id.
ALLOWED_USERS=
# Nơi nhận cảnh báo (tự động đăng dừng, Kaggle lỗi...). Trống = người đầu tiên trong ALLOWED_USERS.
ADMIN_CHAT_ID=

# ===== 2. TÀI KHOẢN & KEY (nhập ở web cũng được: Cài đặt > Tài khoản & API) =====
# Key Gemini, bắt buộc để AI viết lời: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Kaggle, GPU miễn phí 30 giờ/tuần: https://www.kaggle.com/settings > API > Generate New Token
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
# Link web Botkeep cấp cho bot, vd https://ten-may.bot-keep.xyz (Kaggle tải file bạn upload, Telegram gửi link tải)
PUBLIC_URL=
# Fanpage để tự động đăng: ID trang + Page access token (quyền pages_manage_posts, pages_read_engagement, pages_show_list)
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Dự phòng, chỉ khi cần: Groq bóc lời khi không dùng Kaggle; OpenRouter viết lời khi Gemini lỗi
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Proxy cho trình tải khi bị chặn IP: http://user:pass@ip:port hoặc socks5://...
# YTDLP_PROXY=
# Cookies tải video (YTDLP_COOKIES) là nội dung nhiều dòng nên KHÔNG đặt ở file này: dán ở web (Cài đặt > Tài khoản & API).

# ===== 3. TỰ ĐỘNG ĐĂNG (kênh nguồn thêm/bỏ ngay ở mục Tự động đăng trên web cũng được) =====
# 1 = bật, 0 = tắt
AUTO_POST=0
# Kênh Facebook nguồn, cách nhau dấu phẩy (link kênh hoặc tên kênh)
AUTO_SOURCES=
# Kênh TikTok nguồn, cách nhau dấu phẩy (@tên hoặc link tiktok.com/@tên)
AUTO_TIKTOK_SOURCES=
# Lấy video từ: facebook | tiktok | facebook,tiktok (xen kẽ hai nguồn)
AUTO_PLATFORMS=facebook,tiktok
# Số video mỗi ngày, 1-4
AUTO_PER_DAY=2
# Giờ đăng cố định, vd 11:30,20:30. Để trống = bot tự chọn giờ vàng theo lượt xem.
AUTO_TIMES=
# Chế độ làm lại: cook (nấu ăn) | review
AUTO_MODE=cook
# Bỏ video quảng cáo của nguồn (khóa học, tiệc...): 1 | 0
# AUTO_SKIP_ADS=1
# Độ nét tối thiểu của nguồn (chiều cao px), 0 = không lọc
# AUTO_MIN_HEIGHT=540

# ===== 4. TUỲ CHỈNH (để nguyên = mặc định đã thử kỹ; đổi ở web cũng được) =====
# --- Giọng đọc ---
# Nguồn giọng: vieneu (giọng miền Nam đọc trên Kaggle) | edge | capcut
# TTS_PROVIDER=vieneu
# VIENEU_VOICE_FEMALE=Mỹ Duyên
# VIENEU_VOICE_MALE=Adam
# CAPCUT_VOICE_FEMALE=multi_female_yangguangnv_uranus_bigtts
# CAPCUT_VOICE_MALE=multi_male_felipe_uranus_bigtts
# Tốc độ và cao độ giọng edge
# TTS_RATE=+8%
# TTS_PITCH=+0Hz
# Giọng văn: mien_nam | mien_tay | pho_thong
# SPEECH_STYLE=mien_nam
# VOICE_HUMANIZE=1
# TTS_OFFLINE=0
# --- Video & lời ---
# Chất lượng: fast (720p) | balanced | high
# QUALITY=balanced
# TEASER=1
# COVER=1
# Phụ đề: karaoke | box | outline | plain
# SUB_STYLE=karaoke
# SUB_TIMING=spread
# Tên kênh cho màn kết, để trống = không có màn kết
# BRAND_NAME=
# BRAND_LOGO=1
# BRAND_INTRO=1
# --- Phong cách remake & bài đăng ---
# Nhịp dựng: off | light (đổi khung, bỏ thời gian chết, tua nhanh) | strong (thêm điểm danh nguyên liệu, tóm tắt)
# REMAKE_STYLE=off
# Công thức trong bài đăng (định lượng đã đối chiếu lời gốc): 0 | 1
# POST_RECIPE=0
# Mẹo hay: off | post | video
# TIPS=off
# Định lượng không đối chiếu được: strict (bỏ số, ghi vừa đủ) | soft (ghi ước lượng)
# QTY_CHECK=strict
# Chữ ở đoạn tua nhanh: auto | icon | off
# TIME_SKIP_LABEL=auto
# --- Nhận diện kênh ---
# Màu kênh dạng #FF8A00, trống = vàng như cũ
# BRAND_COLOR=
# Tông màu: goc | am_moc | tuoi_sang | dien_anh
# BRAND_LOOK=goc
# BRAND_GRAIN=0
# BRAND_TAGLINE=
# BRAND_CLOSE=
# BRAND_SERIES=
# BRAND_STING=1
# Mẫu ảnh bìa: goc | kenh
# COVER_TEMPLATE=goc
# VOICE_SEPARATION=1
# OST_AUTO=0
# CUT_PROMO=1
# REVIEW_SCRIPT=0
# Video không lời: music (chèn nhạc nền) | narrate (AI viết lời)
# NO_SPEECH=music
# Tiếng gốc khi chèn nhạc: off | low | keep
# BGM_ORIG=off
# BGM_LINKS=
# Phân tích hình: light | fast | full
# SCENE_ANALYSIS=light
# TEXT_DETECT=heuristic
# SOURCE_CREDIT=0
# Kênh gốc được phép (tên kênh), trống = mọi kênh
# ALLOWED_SOURCES=
# --- Kaggle ---
# KAGGLE_USE=1
# KAGGLE_ANALYZE=1
# Model bóc lời trên Kaggle: large-v3 | phowhisper
# KAGGLE_ASR=large-v3
# --- Model AI và bóc lời ---
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_ASR_MODEL=gemini-3.5-transcribe
# OPENROUTER_MODEL=auto
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# ASR_ORDER=groq,gemini,capcut
# Từ điển tên món, nguyên liệu, tên riêng của kênh, cách nhau dấu phẩy
# ASR_VOCAB=

# ===== 5. CHỈ ĐẶT Ở ĐÂY (web không sửa được) =====
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Máy chủ bgutil POT cho YouTube chạy ở máy khác
# POT_SERVER=http://ip:4416
# Chỉ cần khi Botkeep không tự cấp SERVER_PORT: đúng cổng trên link web
# PORT=8080
# Số luồng FFmpeg, 0 = theo số lõi container
# FFMPEG_THREADS=0
# Trần ổ đĩa (MB) cho cache và cho video kết quả giữ để web tải về
# CACHE_MAX_MB=500
# OUT_MAX_MB=400
# Kiểm tra dịch vụ ngoài định kỳ (giờ), 0 = tắt
# HEALTH_CHECK_HOURS=6
# Thêm tên miền được gửi link, cách nhau dấu phẩy
# ALLOWED_DOMAINS=
# 0 = luôn ra 720p (máy thiếu RAM)
# OUTPUT_HD=1
# Giây máy tối đa cho một lần dựng 1080p trên Botkeep trước khi tự hạ 720p, 0 = tắt
# RENDER_BUDGET=600
# 0 = chuẩn hoá âm lượng một lượt (nhanh hơn)
# LOUDNESS_2PASS=1
# Tách giọng trên Botkeep: số luồng, số giây tối đa, 0 = tắt lọc giọng sót
# SEP_THREADS=2
# SEP_BUDGET=180
# SEP_MASK=1
# Phiên bản Graph API của Facebook
# FB_GRAPH_VERSION=v27.0
