# Mẫu file .env cho Video Bot. Chép thành file tên ".env" đặt CÙNG THƯ MỤC với main.py rồi điền giá trị.
# Mỗi dòng một biến: TÊN=giá trị. Giá trị có dấu # hoặc dấu cách thì bọc trong "...".
# Dòng bắt đầu bằng # là ghi chú, bot bỏ qua. Muốn đổi một biến ở mục 4, 5: xoá dấu # ở đầu dòng rồi sửa giá trị.
# Thứ tự ưu tiên: Cài đặt lưu trên web > biến trong panel Botkeep (Startup) > file .env > mặc định trong mã.
# KHÔNG đưa file .env lên GitHub, không gửi cho ai. Sửa .env xong phải khởi động lại bot.

# ===== 1. BẮT BUỘC =====
# Mật khẩu vào web, nên từ 12 ký tự trở lên. Thiếu thì web khoá hoàn toàn.
WEB_PASSWORD=
# Token bot Telegram lấy từ @BotFather. Để trống = chỉ dùng web.
BOT_TOKEN=
# chat_id Telegram được dùng bot, cách nhau dấu phẩy. Chưa biết thì nhắn bot một tin, bot báo chat id.
ALLOWED_USERS=
# Nơi nhận cảnh báo (tự động đăng dừng, Kaggle lỗi...). Trống = người đầu tiên trong ALLOWED_USERS.
ADMIN_CHAT_ID=
# Báo job làm trên web / tự đăng (xong + link tải, lỗi, chờ duyệt) về Telegram + Zoom: 1 | 0
# NOTIFY_JOBS=1

# ===== 2. TÀI KHOẢN & KEY (nhập ở web cũng được: Cài đặt > Tài khoản & API) =====
# Key Gemini, bắt buộc để AI viết lời: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Kaggle, GPU miễn phí 30 giờ/tuần: https://www.kaggle.com/settings > API > Generate New Token
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
# Link web Botkeep cấp cho bot, vd https://ten-may.bot-keep.xyz (Kaggle tải file bạn upload, Telegram gửi link tải)
PUBLIC_URL=
# Fanpage để tự động đăng: ID trang + Page access token (quyền pages_manage_posts, pages_read_engagement, pages_show_list)
FB_PAGE_ID=
FB_PAGE_TOKEN=
# YouTube Shorts (1.2.0): OAuth client Google Cloud (Web application, chuyển hướng PUBLIC_URL/youtube/callback);
# refresh token tự điền khi bấm «▶️ Kết nối YouTube» trên web — KHÔNG đặt ở đây (đặt bằng biến môi trường thì
# nút «Ngắt YouTube» trên web không gỡ được)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
# YT_REFRESH_TOKEN=
# Dự phòng, chỉ khi cần: Groq bóc lời khi không dùng Kaggle; OpenRouter viết lời khi Gemini lỗi
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Zoom Team Chat (bản 1.0.0, chỉ khi cần): gửi link cho bot + nhận thông báo, không gửi file video.
# Zoom Marketplace > Develop > Build App > General App: App Credentials (Client ID / Secret), Features > Access
# (Secret Token), Surface > Team Chat > Chatbot (Bot JID; Bot endpoint URL = PUBLIC_URL + /zoom/events)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_BOT_JID=
ZOOM_SECRET_TOKEN=
# Kiểu app: user (User-managed, mặc định) | admin (Admin-managed)
# ZOOM_APP_TYPE=user
# JID được dùng bot (nhắn bot «id» để biết), cách nhau dấu phẩy. Trống = từ chối tất cả.
# ZOOM_ALLOWED_USERS=
# JID nhận thông báo job web / tự đăng và phiên bản mới. Trống = người đầu tiên ở dòng trên.
# ZOOM_ADMIN=
# Proxy cho trình tải khi bị chặn IP: http://user:pass@ip:port hoặc socks5://...
# YTDLP_PROXY=
# Cookies tải video (YTDLP_COOKIES) là nội dung nhiều dòng nên KHÔNG đặt ở file này: dán ở web (Cài đặt > Tài khoản & API).

# ===== 3. TỰ ĐỘNG ĐĂNG (kênh nguồn thêm/bỏ ngay ở mục Tự động đăng trên web cũng được) =====
# 1 = bật, 0 = tắt
AUTO_POST=0
# Kênh Facebook nguồn, cách nhau dấu phẩy (link kênh hoặc tên kênh)
AUTO_SOURCES=
# Kênh TikTok nguồn, cách nhau dấu phẩy (@tên hoặc link tiktok.com/@tên)
AUTO_TIKTOK_SOURCES=
# Lấy video từ: facebook | tiktok | facebook,tiktok (xen kẽ hai nguồn)
AUTO_PLATFORMS=facebook,tiktok
# Số video mỗi ngày, 1-4
AUTO_PER_DAY=2
# Giờ đăng cố định, vd 11:30,20:30. Để trống = bot tự chọn giờ vàng theo lượt xem.
AUTO_TIMES=
# Chế độ làm lại: cook (nấu ăn) | review
AUTO_MODE=cook
# Bỏ video quảng cáo của nguồn (khóa học, tiệc...): 1 | 0
# AUTO_SKIP_ADS=1
# Có bản ngắn thì đăng bản nào: short | full
# AUTO_POST_VERSION=short
# Độ nét tối thiểu của nguồn (chiều cao px), 0 = không lọc
# AUTO_MIN_HEIGHT=540
# Gói đăng TikTok (video + chữ qua Telegram / Zoom): slot (10 phút trước giờ vàng) | ready (ngay khi xong) | off
# TIKTOK_KIT=slot

# ===== 4. TUỲ CHỈNH (để nguyên = mặc định đã thử kỹ; đổi ở web cũng được) =====
# --- Giọng đọc ---
# Nguồn giọng: vieneu (giọng miền Nam đọc trên Kaggle) | edge | capcut
# TTS_PROVIDER=vieneu
# VIENEU_VOICE_FEMALE=Mỹ Duyên
# VIENEU_VOICE_MALE=Adam
# Whisper (GPU Kaggle) nghe lại giọng VieNeu, câu đọc sai / lặp thì đọc lại: 1 bật | 0 tắt
# VOICE_QA=1
# CAPCUT_VOICE_FEMALE=multi_female_yangguangnv_uranus_bigtts
# CAPCUT_VOICE_MALE=multi_male_felipe_uranus_bigtts
# Tốc độ và cao độ giọng edge
# TTS_RATE=+8%
# TTS_PITCH=+0Hz
# Giọng văn: mien_nam | mien_tay | pho_thong
# SPEECH_STYLE=mien_nam
# VOICE_HUMANIZE=1
# TTS_OFFLINE=0
# --- Video & lời ---
# Chất lượng: fast (720p) | balanced | high
# QUALITY=balanced
# TEASER=1
# COVER=1
# Phụ đề: karaoke | box | outline | plain
# SUB_STYLE=karaoke
# SUB_TIMING=spread
# Tên kênh cho màn kết (mặc định bộ nhận diện «Bếp Đong Đủ»), 0 = không có màn kết
# BRAND_NAME=Bếp Đong Đủ
# BRAND_LOGO=1
# BRAND_INTRO=1
# --- Phong cách remake & bài đăng ---
# Nhịp dựng: off | light (đổi khung, bỏ thời gian chết, tua nhanh) | strong (thêm điểm danh nguyên liệu, tóm tắt)
# REMAKE_STYLE=strong
# Công thức trong bài đăng (định lượng đã đối chiếu lời gốc): 0 | 1
# POST_RECIPE=1
# Mẹo hay: off | post | video
# TIPS=video
# Định lượng không đối chiếu được: strict (bỏ số, ghi vừa đủ) | soft (ghi ước lượng)
# QTY_CHECK=strict
# Chữ ở đoạn tua nhanh: auto | icon | off
# TIME_SKIP_LABEL=auto
# Thêm bản ngắn ≤ 90 giây cho Reels: off | on
# SHORT_VERSION=on
# --- Nhận diện kênh ---
# Màu kênh dạng #FF8A00, 0 = vàng như cũ
# BRAND_COLOR=#F28C28
# Tông màu: auto (tự chọn theo từng video) | goc | am_moc | tuoi_sang | dien_anh
# BRAND_LOOK=auto
# BRAND_GRAIN=0
# Câu dưới tên kênh / câu chốt đọc cuối video / tên loạt trên ảnh bìa (0 = không có)
# BRAND_TAGLINE=Đong đủ, nấu là ngon
# BRAND_CLOSE=Đong đủ là ngon, cả nhà nấu thử nha
# BRAND_SERIES=Hôm nay nấu gì
# BRAND_STING=1
# Mẫu ảnh bìa: goc | kenh
# COVER_TEMPLATE=kenh
# VOICE_SEPARATION=1
# OST_AUTO=0
# CUT_PROMO=1
# REVIEW_SCRIPT=0
# Video không lời: music (chèn nhạc nền) | narrate (AI viết lời)
# NO_SPEECH=music
# Tiếng gốc khi chèn nhạc: off | low | keep
# BGM_ORIG=off
# Nguồn nhạc nền kênh bếp: lyria = kho nhạc tự tạo theo món (Lyria RealTime, key Gemini; lệnh cook_bgm tạo đủ kho) | files = chỉ thư viện link / file của bạn
# BGM_SOURCE=lyria
# BGM_LINKS=
# Nhạc lót thật nhỏ dưới lời đọc (lấy từ thư viện nhạc nền; chỉ dùng nhạc miễn phí bản quyền): on | off
# VOICE_BED=on
# Phân tích hình: light | fast | full
# SCENE_ANALYSIS=light
# TEXT_DETECT=heuristic
# Xoá chữ in cứng bằng LaMa (big-lama.pt) trên Kaggle khi phân tích ở đó: 1 bật, chỉ chỗ có chữ (lỗi thì che mờ như cũ)
# | band bật, vẽ lại cả dải như bản cũ | 0 che mờ
# TEXT_INPAINT=1
# Khung dọc theo nội dung: bỏ dải đen, nguồn ngang cắt theo tay / chảo hoặc nền mờ: 1 | 0 (cắt giữa như cũ)
# FRAMING_AUTO=1
# Cảnh người gốc nói vào máy: 1 = đẩy cận neo đáy xuống tay / món (kế hoạch dựng) | 0 (mặc định)
# TALK_ZOOM=0
# SOURCE_CREDIT=0
# Kênh gốc được phép (tên kênh), trống = mọi kênh
# ALLOWED_SOURCES=
# --- Kaggle ---
# KAGGLE_USE=1
# KAGGLE_ANALYZE=1
# Model bóc lời trên Kaggle: large-v3 | phowhisper
# KAGGLE_ASR=large-v3
# Model tách giọng gốc ở phiên phân tích Kaggle: kim (mặc định) | auto (thử nghiệm: RoFormer trên GPU, lỗi thì Kim_Vocal_2)
# VOICE_SEP_MODEL=kim
# Bỏ nhạc gốc, chỉ giữ tiếng động (Bandit trên Kaggle GPU; trọng số phi thương mại, bật kiếm tiền thì đặt 0): 1 | 0
# SFX_SEP=1
# Nội suy khung RIFE khi video gốc bị kéo chậm (dựng trên Kaggle GPU): 1 | 0
# INTERP=1
# --- Model AI và bóc lời ---
# GEMINI_MODEL=gemini-3.5-flash-lite
# Model chính quá tải (503) / hết lượt ngày thì thử lần lượt các model này (để trống = không thử)
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
# GEMINI_ASR_MODEL=gemini-3.5-transcribe
# OPENROUTER_MODEL=auto
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# ASR_ORDER=groq,gemini,capcut
# Từ điển tên món, nguyên liệu, tên riêng của kênh, cách nhau dấu phẩy
# ASR_VOCAB=

# --- 🧸 Truyện bé (kênh «Kể Bé Nghe», docs/KE_HOACH_KIDS_STORY.md): làm trên Kaggle, đăng Fanpage RIÊNG ---
# KIDS_AUTO=0
# KIDS_TIMES=08:00,19:00
# Fanpage riêng của kênh truyện bé (id + token Page như FB_PAGE_TOKEN; me/accounts liệt kê cả hai Page)
KIDS_FB_PAGE_ID=
KIDS_FB_PAGE_TOKEN=
# Kênh YouTube riêng của truyện bé (tự điền khi bấm «▶️ Kết nối YouTube kênh bé», không đặt ở đây)
# KIDS_YT_REFRESH_TOKEN=
# Gói đăng TikTok kênh bé: slot | ready | off
# KIDS_TIKTOK_KIT=slot
# Giọng kể VieNeu miền Nam: Thục Đoan | Mỹ Duyên | Kim Thanh | Thùy Dung
# KIDS_VOICE=Thục Đoan
# Lời thoại đọc bằng giọng riêng từng nhân vật (giọng trong rmvideo/kids/data.json): 1 bật | 0 một giọng
# KIDS_MULTI_VOICE=1
# Giọng đọc từ tiếng Anh (edge-tts, phần tiếng Việt vẫn VieNeu): en-US-JennyNeural | en-US-AnaNeural (bé gái) | en-US-AvaNeural | en-US-GuyNeural | off = VieNeu đọc luôn (phát âm sai)
# KIDS_EN_VOICE=en-US-JennyNeural
# Model vẽ ảnh: schnell (FLUX.1-schnell 4-bit) | zimage (Z-Image-Turbo)
# KIDS_IMAGE_MODEL=schnell
# Kiểm ảnh sau khi vẽ: OWLv2 đếm đầu nhân vật, thừa đầu (ảnh hai đầu / nhân đôi) thì vẽ lại cảnh; 0 = tắt
# KIDS_IMAGE_CHECK=1
# LoRA 4 nhân vật (file trong dataset Kaggle rmvideo-kids-lora; notebook:slug/tên để lấy từ notebook); off = không dùng
# KIDS_LORA=dcn_lora_v1
# Ai viết truyện: auto (Gemini trên Botkeep, lỗi thì Qwen trên Kaggle) | gemini | qwen
# KIDS_LLM_PROVIDER=auto
# Model Gemini viết nháp truyện bé (Gemini 4 Hydrogen free tier, 1 lượt/truyện); trống = GEMINI_MODEL
# KIDS_GEMINI_MODEL=gemini-4-hydrogen
# Model Gemini viết lại theo lỗi bộ kiểm và tự soát (hạn mức free rộng); trống = cùng model viết nháp
# KIDS_GEMINI_REVISE_MODEL=gemini-3.5-flash-lite
# Mức suy nghĩ của Gemini 4 khi viết nháp: low (mặc định) / medium / high
# KIDS_GEMINI_THINKING=low
# KIDS_LLM_PATTERN=*Qwen3.6-35B-A3B*Q4_K_M*.gguf
# KIDS_LLM_HF=lmstudio-community/Qwen3.6-35B-A3B-GGUF
# Model chữ suy nghĩ trước khi viết, tối đa chừng này token (0 = tắt; ~60 token/giây trên 2 T4)
# KIDS_LLM_THINK=1200
# Trống = notebook rmvideo-kids-models (lệnh console kids_setup); hoặc notebook:user/slug, dataset:user/slug
# KIDS_KAGGLE_SOURCES=
# KIDS_CHANNEL_NAME=Kể Bé Nghe
# KIDS_WORLD_NAME=Đồi Cỏ Non
# KIDS_TAGLINE=Mỗi ngày một chuyện nhỏ ở Đồi Cỏ Non, học vài từ tiếng Anh
# KIDS_HASHTAGS=#kebenghe,#doiconon,#truyenchobe,#hoctienganhchobe,#kidsstory
# Nhạc nền trẻ em: link Kaggle tự tải, hoặc chép file vào assets/kids_bgm/ (cần PUBLIC_URL)
# Hiệu ứng động truyện bé: full (chuyển động + hạt + tiếng động) | motion | off
# KIDS_FX=full
# KIDS_BGM_LINKS=
# Nhạc nền truyện bé: auto (file/link của mình nếu có, không thì kho Lyria RealTime tự tạo) / lyria / files / off
# KIDS_BGM=auto

# ===== 5. CHỈ ĐẶT Ở ĐÂY (web không sửa được) =====
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Máy chủ bgutil POT cho YouTube chạy ở máy khác
# POT_SERVER=http://ip:4416
# Chỉ cần khi Botkeep không tự cấp SERVER_PORT: đúng cổng trên link web
# PORT=8080
# Số luồng FFmpeg, 0 = theo số lõi container
# FFMPEG_THREADS=0
# Trần ổ đĩa (MB) cho cache và cho video kết quả giữ để web tải về
# CACHE_MAX_MB=500
# OUT_MAX_MB=400
# Kiểm tra dịch vụ ngoài định kỳ (giờ), 0 = tắt
# HEALTH_CHECK_HOURS=6
# Thêm tên miền được gửi link, cách nhau dấu phẩy
# ALLOWED_DOMAINS=
# 0 = luôn ra 720p (máy thiếu RAM)
# OUTPUT_HD=1
# Giây máy tối đa cho một lần dựng 1080p trên Botkeep trước khi tự hạ 720p, 0 = tắt
# RENDER_BUDGET=600
# 0 = chuẩn hoá âm lượng một lượt (nhanh hơn)
# LOUDNESS_2PASS=1
# Tách giọng trên Botkeep: số luồng, số giây tối đa, 0 = tắt lọc giọng sót
# SEP_THREADS=2
# SEP_BUDGET=180
# SEP_MASK=1
# Phiên bản Graph API của Facebook
# FB_GRAPH_VERSION=v27.0
